# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# JWT signing secret — use a long random string in production (never commit real secrets)
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: prisma/seed.mjs admin user (defaults shown in seed if unset)
SEED_ADMIN_NAME="Admin User"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!"

# Uploads: filesystem path the app writes to, and public URL prefix for links
ATTACHMENT_DIR=./public/uploads
ATTACHMENT_URL_BASE=/uploads

# Docker only: host path mapped to ATTACHMENT_DIR (see docker-compose volumes)
HOST_ATTACHMENT_DIR=./public/uploads