generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  passwordHash String
  displayName  String
  role         String    @default("member")
  createdAt    DateTime  @default(now())

  channels   Channel[]
  posts      Post[]
  replies    Reply[]
  votes      Vote[]
}

model Channel {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdById String
  createdAt   DateTime  @default(now())

  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  posts     Post[]
}

model Post {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())

  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies    Reply[]
}

model Reply {
  id            String   @id @default(cuid())
  postId        String
  parentReplyId String?
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentReply  Reply?   @relation("ReplyReplies", fields: [parentReplyId], references: [id], onDelete: SetNull)
  childReplies Reply[]  @relation("ReplyReplies")
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Vote {
  id         String @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  value      Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}

model Attachment {
  id         String  @id @default(cuid())
  targetType String
  targetId   String
  mimeType   String
  sizeBytes  Int
  path       String
}
